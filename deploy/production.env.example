# Copy into .local/production.env on the server (chmod 600).
DB_URL=jdbc:mysql://mysql:3306/inteliagent
DB_HOST=mysql
DB_PORT=3306
DB_NAME=inteliagent
JWT_SECRET=GENERATE_BASE64_RANDOM_48_BYTES
CORS_ORIGINS=https://inteliagent.com.br,https://www.inteliagent.com.br
SMTP_HOST=CONFIGURE_SMTP_PROVIDER
SMTP_PORT=587
SMTP_AUTH=true
SMTP_TLS=true
SMTP_USER=CONFIGURE_SMTP_USER
SMTP_PASSWORD=CONFIGURE_SMTP_PASSWORD
MAIL_FROM=CONFIGURE_VERIFIED_SENDER
# Each service has a separate .local/<service>.env with DB_USER and DB_PASSWORD.
# Database admin password is only in .local/database.env; migration has its own account.
